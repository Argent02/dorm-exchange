# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dormexchange?schema=public"

# Firebase Admin SDK
# Download your service account key from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Server
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins in production (optional in local dev)
# Example: CORS_ORIGIN="https://app.example.com,https://staging.example.com"
CORS_ORIGIN=
