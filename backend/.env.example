# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dormexchange?schema=public"

# Firebase Admin SDK
# Download your service account key from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Server
NODE_ENV=development
PORT=3000

# Required when NODE_ENV=production — comma-separated allowed browser origins.
# Optional in local development (omit or leave empty for permissive CORS).
# Example: CORS_ORIGIN="https://app.example.com,https://staging.example.com"
CORS_ORIGIN=

# Required (always) — comma-separated list of allowed student email domains
# (the part after the "@"). Only Firebase-authenticated users whose email ends
# in one of these domains can use any authenticated API route.
# Add more schools by adding more comma-separated domains — no code change needed.
# Example: ALLOWED_EMAIL_DOMAINS="niu.edu,otherschool.edu"
ALLOWED_EMAIL_DOMAINS="niu.edu"
